<domain type='qemu'>
  <name>retroclaude-win98</name>
  <title>RetroClaude Windows 98 SE</title>
  <description>Win98 SE guest for RetroClaude. Hardware follows docs/PLAN.md:
i440fx (Win98 predates q35), pcnet NIC (most consistently reported working on
Win98), Cirrus VGA (in-box driver), PS/2 input (Win98 has no HID tablet
driver, so a usb-tablet would silently do nothing). Installed with 128MB for
speed; drop to 32MB afterwards to match the real Pentium MMX 200 target.</description>
  <memory unit='MiB'>128</memory>
  <currentMemory unit='MiB'>128</currentMemory>
  <vcpu placement='static'>1</vcpu>
  <os>
    <type arch='i686' machine='pc-i440fx-9.2'>hvm</type>
    <!-- Hard disk only. The floppy ran once to `sys c:` and launch Setup;
         leaving it in the boot order means Setup's reboot lands back on it
         and starts over, and ejecting mid-boot is a race that loses. -->
    <!-- Floppy first, for the single boot that runs `sys c:` and starts
         Setup. The sitter then ejects it from the running domain AND from
         this persistent config: a live-only eject is undone by the next
         restart, which re-inserts the media and puts Setup into an endless
         restart loop. -->
    <boot dev='fd'/>
    <boot dev='hd'/>
    <bootmenu enable='no'/>
  </os>
  <!-- No APIC, and no ACPI.
       Win98 is a PIC-era OS: it never programs the IOAPIC. With <apic/>
       enabled, QEMU routes IRQ0 to an IOAPIC whose pins Win98 leaves masked,
       so the timer interrupt is swallowed. Observed directly: pic0 irr=43
       (IRQ0 pending) imr=b8 (IRQ0 unmasked) isr=00 (nothing blocking) while
       the CPU spun with IF=1, and the BIOS tick at 0040:006C never advanced.
       Win98's real-mode boot waits on exactly that counter. -->
  <features/>
  <!-- TCG, not KVM, deliberately.
       Win98 guests are reported to suffer "missing DLL" / missing-export
       crashes under KVM even when the files on disk are provably correct:
       SHELL32 failed to link against a byte-identical SHLWAPI here. TCG is
       slower but correct, and still far faster than the Pentium MMX 200 this
       is ultimately emulating. -->
  <cpu mode='custom' match='exact' check='none'>
    <model fallback='allow'>pentium2</model>
  </cpu>
  <clock offset='localtime'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-i386</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/home/tibi/Dev/RetroAI/vm/win98.qcow2'/>
      <target dev='hda' bus='ide'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/tibi/Dev/RetroAI/vm/win98se.iso'/>
      <target dev='hdc' bus='ide'/>
      <readonly/>
    </disk>
    <disk type='file' device='floppy'>
      <driver name='qemu' type='raw'/>
      <source file='/home/tibi/Dev/RetroAI/vm/boot98.img'/>
      <target dev='fda' bus='fdc'/>
    </disk>

    <controller type='ide' index='0'/>
    <controller type='fdc' index='0'/>
    <interface type='user'><model type='pcnet'/></interface>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <graphics type='vnc' port='-1' listen='127.0.0.1'/>
    <video><model type='cirrus' vram='4096' heads='1'/></video>
    <memballoon model='none'/>
  </devices>
</domain>
