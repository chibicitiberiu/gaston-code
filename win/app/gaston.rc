/* Resources for retroclaude.exe.
 *
 * Compiled by wrc and bound at link time (see win/Makefile). Before this
 * file existed the EXE carried no resource section at all: the window and
 * the taskbar showed IDI_APPLICATION, the generic white page, and the file's
 * Properties tab had no Version page.
 *
 * Deliberately NOT here: dialog templates. The Server Host dialog is built
 * with DialogBoxIndirectParam from a template composed at runtime, because
 * the control layout has to adapt to the system font metrics on a 640x480
 * guest -- a compiled template is fixed in dialog units and would clip. The
 * resource pipeline exists for the things that genuinely are static data.
 */

#include "app/resource.h"

/* The icon is 16x16 and 32x32, 4bpp, standard VGA palette -- generated by
 * tools/mkicon.py, which explains at length why it is not a 32bpp file from
 * a modern tool. Win98 has no alpha compositing and would render the margin
 * of such a file as a black square on the taskbar. */
IDI_GASTON ICON "app/gaston.ico"

/* The status bar's connection states. Same generator, same palette, same
 * reason for 4bpp: Win98 has no alpha compositing. */
IDI_NET_OK   ICON "app/netok.ico"
IDI_NET_WARN ICON "app/netwarn.ico"
IDI_NET_BAD  ICON "app/netbad.ico"

/* Win98 reads this for the Version tab of the file's Properties sheet, and
 * it is the only place the binary says what it is when it is not running. */
1 VERSIONINFO
FILEVERSION    RC_VER_MAJOR,RC_VER_MINOR,RC_VER_PATCH,0
PRODUCTVERSION RC_VER_MAJOR,RC_VER_MINOR,RC_VER_PATCH,0
FILEOS         0x4L          /* VOS__WINDOWS32 */
FILETYPE       0x1L          /* VFT_APP        */
FILESUBTYPE    0x0L
{
  BLOCK "StringFileInfo"
  {
    /* 040904E4 = US English, Windows multilingual (codepage 1252). Not
     * Unicode: the strings below are ANSI and the block's codepage has to
     * say so or the properties tab shows mojibake. */
    BLOCK "040904E4"
    {
      /* No CompanyName key at all. An EMPTY one is worse than a missing
       * one: Win98's Version tab lists every key it finds, so "" shows up
       * in the Other version information box as a row that selects to a
       * blank value -- verified on the guest. */
      VALUE "FileDescription",  "Gaston Code\0"
      VALUE "FileVersion",      RC_VER_STR "\0"
      VALUE "InternalName",     "retroclaude\0"
      /* Win98 gives LegalCopyright its own labelled line at the top of the
       * tab, above the fold, rather than burying it in the list. */
      VALUE "LegalCopyright",   "Copyright (c) 2026 Tiberiu Chibici. MIT.\0"
      VALUE "OriginalFilename", "RETROCL.EXE\0"
      VALUE "ProductName",      "Gaston Code\0"
      VALUE "ProductVersion",   RC_VER_STR "\0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x409, 1252
  }
}

/* Keyboard accelerators.
 *
 * Only the keys whose meaning does NOT depend on what has focus live here.
 * A Win32 accelerator is translated for the whole message before anything
 * else sees it, regardless of msg.hwnd -- so a key that must behave one way
 * in the input box and another in the transcript cannot be an accelerator at
 * all, and PgUp/PgDn/Ctrl+Home/Ctrl+End stay hand-rolled in the message loop
 * (see the comment there). Putting them here would silently steal
 * caret-to-start and caret-to-end from a multiline EDIT.
 *
 * Ctrl+N IS global, on purpose: that is what it means in every Windows
 * application, and the draft that made it focus-dependent would have made it
 * unreachable, because the input box holds focus almost all the time. The
 * risk it carries -- discarding a half-typed message -- is handled where the
 * risk actually is, by confirming when the box is not empty.
 */
IDA_MAIN ACCELERATORS
{
    "N",        IDM_NEW,      VIRTKEY, CONTROL
    VK_F5,      IDA_REFRESH,  VIRTKEY
    VK_PRIOR,   IDA_PAGEPREV, VIRTKEY, CONTROL
    VK_NEXT,    IDA_PAGENEXT, VIRTKEY, CONTROL
}
